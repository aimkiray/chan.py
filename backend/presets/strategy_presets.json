    {
      "name": "balanced_purify_5m",
      "version": "2026.07.07",
      "status": "active",
      "description": "5min 默认均衡提纯策略，适合样本充足、波动适中的个股。",
      "tags": ["5m", "balanced", "xgboost", "buy"],
      "scenario": {
        "frequency": "5m",
        "holding": "short_swing",
        "suitable_for": ["成交活跃", "趋势和震荡切换", "买点样本充足"],
        "avoid": ["极端低流动性", "原始买点盈亏比显著偏弱"]
      },
      "params": {
        "frequency": "5m",
        "data_length_mode": "default",
        "data_length_years": 0.25,
        "model": "xgboost",
        "feature_preset": "purify_compact",
        "side_filter": "buy",
        "profit_lookahead": 6,
        "holding_period": 6,
        "trade_cost": 0.001,
        "topk_frac": 0.2,
        "backtest_mode": "walk_forward",
        "walk_forward_max_folds": 20,
        "rank_transform_enabled": true,
        "enforce_t1": true
      },
      "gates": [
        {"metric": "sample_summary.buy", "op": ">=", "value": 200, "message": "buy samples should be at least 200"},
        {"metric": "roc_auc", "op": ">=", "value": 0.58, "message": "AUC should show useful ranking power"},
        {"metric": "brier_score", "op": "<=", "value": 0.25, "message": "probability calibration should stay controlled"},
        {"metric": "trading.topk.avg_net_profit", "op": ">", "value": 0.0, "message": "top-k net expectancy must be positive"},
        {"metric": "trading.topk.profit_factor", "op": ">=", "value": 1.3, "message": "top-k profit factor should clear the live threshold"}
      ],
      "score": {
        "terms": [
          {"metric": "trading.topk.avg_net_profit", "weight": 100.0},
          {"metric": "trading.topk.profit_factor", "weight": 0.2, "infinite": 10.0},
          {"metric": "roc_auc", "weight": 1.0},
          {"metric": "brier_score", "weight": -0.8}
        ]
      }
    },
