# ClickHouse Configuration (Required if using ClickHouse source)
DB_HOST=localhost
DB_PORT=9000
DB_USER=default
DB_PASSWORD=
DB_NAME=stock_data

# Performance & Concurrency Tuning
# Max concurrent processes for pretrain data collection (default: min(60, cpu_count))
# Reduce this if you experience high system load or database connection issues.
MLCHAN_PRETRAIN_WORKERS=60

# Max concurrent processes for strategy execution (default: min(60, cpu_count))
# Reduce this if you experience high system load or database connection issues.
MLCHAN_STRATEGY_WORKERS=60

# Job Management (Backend)
# Maximum number of pretrain job records to keep in memory (default: 50)
MLCHAN_PRETRAIN_JOBS_MAX=50

# Time-to-live for pretrain job records in seconds (default: 21600 = 6 hours)
MLCHAN_PRETRAIN_JOBS_TTL_SEC=21600
