# ClickHouse Configuration (Required if using ClickHouse source)
# ClickHouse 连接信息（使用 ClickHouse 数据源时需要）
# 默认值来自 DataAPI/ClickHouseAPI.py 的 os.getenv(..., default)
DB_HOST=localhost
DB_PORT=9000
DB_USER=default
DB_PASSWORD=
DB_NAME=stock_data

# Performance & Concurrency Tuning
# 并发预训练 worker 数（默认：min(60, CPU 核心数)，并且不超过 codes 数量；最小为 1）
# 典型问题：数据库连接被打满 / 机器负载过高时，把它调小（比如 8、16）
MLCHAN_PRETRAIN_WORKERS=60

# 并发策略执行 worker 数（默认：min(60, CPU 核心数)；最小为 1）
# 典型问题：策略回测占用 CPU/内存过高时，把它调小（比如 4、8）
MLCHAN_STRATEGY_WORKERS=60

# Job Management (Backend)
# 内存中最多保留多少条 pretrain 任务记录（默认：50）
MLCHAN_PRETRAIN_JOBS_MAX=50

# pretrain 任务记录的 TTL（秒）（默认：21600 = 6 小时）
MLCHAN_PRETRAIN_JOBS_TTL_SEC=21600

# Model Cache
# 预训练模型缓存目录
# 默认：backend/chan_service.py 同目录下的 model_cache（即 backend/model_cache）
# 说明：会写入 *.pkl.gz（模型包）和 *.json（元信息）
MLCHAN_MODEL_CACHE_DIR=

# Walk-Forward / Rolling Sampling
# 采样相关（用于 trigger_step 的样本采集）
# 启用滚动采样（默认：1；可选：1/0，true/false，yes/no，on/off）
MLCHAN_ROLLING_SAMPLE_ENABLED=1
# 滚动采样步长（默认：按周期自动选择；若解析失败则回退为 1）
# - 1m: 20
# - 5m: 8
# - 15m: 4
# - 30m: 4
# - 60m: 2
# - 其它: 1
MLCHAN_ROLLING_SAMPLE_STRIDE=

# Feature Engineering / Selection
# 时间序列切分中验证集占比下限（默认：0.2；会被 clamp 到 [0.2, 0.5)）
# 用途：
# - 树模型训练时（train_model_from_xy）如果未传 X_val/y_val，会自动按该比例切出验证集用于 early stopping 评估
# - 部分校准逻辑会用它做内部切分
MLCHAN_VAL_FRACTION=0.2
# 特征重要性保留比例（默认：0.5；代码会强制上限 <= 0.5；最少保留 2 个特征）
# 用途：train_model_with_feature_selection 中按 feature importance 先做一次降维
MLCHAN_FEATURE_KEEP_FRACTION=0.5
# 相关性剪枝阈值（默认：0.9；范围 (0, 0.999)）
# 用途：train_model_with_feature_selection 中对保留特征做相关性去冗余
MLCHAN_FEATURE_CORR_THRESHOLD=0.9
# 强制保留的特征列表（逗号分隔）
# 默认：seg_last_dir,bsp3_zs_height
# 用途：在部分特征筛选逻辑中强制保留这些特征，避免“筛掉关键特征”
MLCHAN_FORCE_FEATURES=seg_last_dir,bsp3_zs_height
MLCHAN_ONLY_FEATURES=bsp3_zs_height,volatility_250,bsp1_bi_amp,bsp2_bi_amp,bi_last_amp_r
# 强制丢弃的特征列表（逗号分隔）
# 默认：zs_last_is_sure
# 用途：快速做 ablation / 排除疑似噪声特征
MLCHAN_DROP_FEATURES=zs_last_is_sure

# Monotonic Constraints (Tree Models)
# 单调性约束模式：
# - none: 关闭
# - fixed: 只用固定约束表
# - ic: 只用 IC 符号（按训练集自动推断正/负相关）
# - fixed+ic: 固定表 + IC 符号（默认；优先 fixed，缺省再用 ic）
# 固定约束表（当前版本）包含：
# - volatility_250: +1
# - zs_height: +1
# - bsp1_bi_amp: -1
# - bsp2_bi_amp: +1
# - bi_last_amp_r: +1
# - bsp2s_retrace_rate: -1
# - seg_last_dir: +1
# - bsp3_zs_height: +1
MLCHAN_MONOTONE_MODE=none

# Winsorization / Outlier Clipping
# 特征截尾开关（默认：1；可选：1/0，true/false，yes/no，on/off）
# 行为：
# - 仅用训练集计算每一列的分位数上下界
# - 将 train/val/test 的对应列 clip 到该范围
# - 跳过缺失值（-9999999）与非有限值
MLCHAN_WINSORIZE=1
# 截尾下分位（默认：0.01；会被 clamp 到 [0.0, 0.25]）
MLCHAN_WINSORIZE_LO=0.01
# 截尾上分位（默认：0.99；会被 clamp 到 [0.75, 1.0]）
MLCHAN_WINSORIZE_HI=0.99
# 计算分位数所需最小样本数（默认：50；最小 10）
MLCHAN_WINSORIZE_MIN_N=50

# Rank Transformation (Percentile Rank)
# 特征排序化开关（默认：1；可选：1/0，true/false，yes/no，on/off）
# 行为：
# - 仅用训练集为每一列拟合“值 -> 百分位排名(0~1)”映射
# - 对 train/val/test 应用相同映射，降低长尾/异常值对模型的破坏
MLCHAN_RANK_TRANSFORM=0
# 每列拟合 rank 映射所需的最小有效样本数（默认：30；最小 5）
MLCHAN_RANK_MIN_N=30
# 仅对指定特征做 rank（逗号分隔）；留空表示对所有特征做
MLCHAN_RANK_FEATURES=

# Calibration
# 是否允许 temperature scaling（默认：0）
# 说明：
# - 只有设置为 1 才会让 calibrate_method=temperature 生效
# - 这是为了避免在排序能力较弱（AUC 低）时，温度标定掩盖根因
MLCHAN_ENABLE_TEMPERATURE=0

# XGBoost Hyperparameters (Optional)
# 不填则使用代码默认（更偏向强正则/低学习率的稳健配置）：
# - n_estimators=500
# - learning_rate=0.01
# - max_depth=3
# - reg_alpha=0.0
# - reg_lambda=10.0
# - subsample=1.0
# - colsample_bytree=1.0
# - missing=-9999999
# - random_state=42
MLCHAN_XGB_N_ESTIMATORS=
MLCHAN_XGB_LEARNING_RATE=0.05
MLCHAN_XGB_MAX_DEPTH=3
MLCHAN_XGB_REG_ALPHA=0.0
MLCHAN_XGB_REG_LAMBDA=0.0
MLCHAN_XGB_SUBSAMPLE=
MLCHAN_XGB_COLSAMPLE_BYTREE=

# LightGBM Hyperparameters (Optional)
# 不填则使用代码默认（更偏向强正则/低学习率的稳健配置）：
# - n_estimators=500
# - learning_rate=0.01
# - max_depth=3
# - reg_alpha=0.0
# - reg_lambda=10.0
# - verbosity=-1
MLCHAN_LGB_N_ESTIMATORS=
MLCHAN_LGB_LEARNING_RATE=
MLCHAN_LGB_MAX_DEPTH=
MLCHAN_LGB_REG_ALPHA=
MLCHAN_LGB_REG_LAMBDA=
